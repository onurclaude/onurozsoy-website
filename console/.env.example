ADMIN_USER=onur
ADMIN_PASSWORD=change-this-password

# Contact form mail delivery (SMTP of the mailbox that sends the notification).
# Leave unset and the form returns an error instead of sending.
MAIL_TO=onur@ozsoyonur.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=onur@ozsoyonur.com
SMTP_PASS=change-this-password
# Optional; defaults to "ozsoyonur.com" <SMTP_USER>. Must be a sender your SMTP account may use.
# SMTP_FROM="ozsoyonur.com" <onur@ozsoyonur.com>
